# ─── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── AI Provider ─────────────────────────────────────────
# Choose: gemini (default) or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite          # opsional, default: gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here      # only needed if AI_PROVIDER=openai

# ─── Google Sheets ────────────────────────────────────────
# Spreadsheet ID from the URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=your_production_spreadsheet_id_here
GOOGLE_SHEETS_ID_TEST=your_testing_spreadsheet_id_here   # for seed_test_data.py

# Path to the service account JSON file downloaded from Google Cloud Console
# Alternatively, paste the JSON content directly as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json

# ─── Mode ─────────────────────────────────────────────────
# prod = use GOOGLE_SHEETS_ID (default)
# test = use GOOGLE_SHEETS_ID_TEST (for dashboard testing with seed data)
MODE=prod

# ─── Default Currency ─────────────────────────────────────
# Supported: IDR | USD | EUR | GBP
# This is the global fallback; per-user currency is saved in the Users sheet
DEFAULT_CURRENCY=GBP

# ─── Superuser ────────────────────────────────────────────
# Telegram chat_id(s) with admin access to the dashboard Admin page
# Comma-separated if multiple: 123456789,987654321
SUPERUSER_CHAT_IDS=your_telegram_chat_id_here
